# Optional. This value is loaded locally and is never logged.
PORTFOLIO_MANAGER_EMAIL=portfolio.manager@example.com

# Optional momentum overrides. Defaults are shown below.
# MOMENTUM_DB_PATH=C:\path\to\persistent\momentum.db
# MOMENTUM_TRADING_DAYS_6M=126
# MOMENTUM_TRADING_DAYS_12M=252
# MOMENTUM_ANNUALIZATION_DAYS=252
# MOMENTUM_PRICE_HISTORY_PERIOD=15mo
# MOMENTUM_MIN_VOLATILITY=1e-8

# Market data vendor. Yahoo remains the default until LSEG is configured.
# MARKET_DATA_PROVIDER=yahoo

# LSEG Data Library / Datastream adapter settings.
# MARKET_DATA_PROVIDER=lseg
# LD_LIB_CONFIG_PATH=/opt/airflow/config/lseg-data.config.json
# LSEG_SP500_UNIVERSE=0#.SPX
# LSEG_CLOSE_FIELD=TRDPRC_1
# LSEG_MOMENTUM_FIELD=TRDPRC_1
# LSEG_RIC_FIELD=TR.RIC
# LSEG_SYMBOL_FIELD=TR.ExchangeTicker
# LSEG_SECTOR_FIELD=TR.TRBCEconomicSector
# LSEG_INDUSTRY_FIELD=TR.TRBCIndustry
# LSEG_HISTORY_BATCH_SIZE=50
# LSEG_MIN_UNIVERSE_SIZE=400

# Airflow deployment defaults. Airflow Variables with the corresponding
# lowercase names take precedence for recipient lists in the DAG.
# MORNING_BRIEF_SCHEDULE=0 7 * * *
# MORNING_BRIEF_TO=portfolio.manager@example.com
# MORNING_BRIEF_CC=
# MORNING_BRIEF_BCC=
# MARKET_BRIEF_DB_PATH=/opt/airflow/data/market_brief.db

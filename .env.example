# Optional local recipient; leave blank until configured.
# PORTFOLIO_MANAGER_EMAIL=your.test.address@example.com

# The only data source is data/internal_data_source.py.
# Fill its four loaders; no provider-selection setting is required.
# Configure your SQL/LSEG client's credentials in your secret store.

# Optional momentum overrides.
# MOMENTUM_DB_PATH=C:/path/to/persistent/momentum_lseg.db
# MOMENTUM_TRADING_DAYS_6M=126
# MOMENTUM_TRADING_DAYS_12M=252
# MOMENTUM_ANNUALIZATION_DAYS=252
# MOMENTUM_MIN_VOLATILITY=1e-8

# Airflow: lowercase recipient Variables take precedence.
# MORNING_BRIEF_SCHEDULE=0 7 * * *
# MORNING_BRIEF_TO=your.test.address@example.com
# MORNING_BRIEF_CC=
# MORNING_BRIEF_BCC=
# MOMENTUM_DB_PATH=/opt/airflow/data/momentum_lseg.db
# MARKET_BRIEF_DB_PATH=/opt/airflow/data/market_brief.db
